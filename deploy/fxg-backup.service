[Unit]
Description=Back up saha.ing's database, blobs and spaces' git repositories
After=fxg-crew.service

[Service]
Type=oneshot
# Runs as root so it can read the service's state directory and write to
# /var/backups. It reads and copies; it never writes into the live data.
ExecStart=/opt/fxg-crew/deploy/backup.sh --verify
Environment=DATABASE_PATH=/var/lib/fxg-crew/saha.db
Environment=BLOB_ROOT=/var/lib/fxg-crew/blobs
Environment=SPACES_ROOT=/var/lib/fxg-crew/spaces
Environment=BACKUP_ROOT=/var/backups/fxg-crew
