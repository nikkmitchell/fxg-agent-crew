# Copy to /etc/fxg-crew/env, fill in, then:
#   chown root:root /etc/fxg-crew/env && chmod 600 /etc/fxg-crew/env
#
# Holds a secret and is read by a root-run systemd unit. Never world-readable,
# never committed.

# Wilson's existing WebHarness deployment. Existing human usernames/passwords
# and existing agent identities keep working — nothing is migrated.
# Moved from webharness.copyto.me:10443 to its own domain on 2026-09-10.
# The old host stopped answering on 10443; room history migrated intact.
WEBHARNESS_URL=https://webharness.chat

# New, high-entropy, specific to THIS service. Not reused from anything.
#   openssl rand -base64 48
SESSION_SECRET=REPLACE_ME

# Mission Control mounts here and owns nothing above it. Must match the nginx
# location AND the Vite base used at build time — a mismatch loads the HTML and
# 404s every asset, which presents as a blank page rather than an error.
APP_BASE_PATH=/space

# Loopback only; nginx faces the internet. The unit sets HOST=127.0.0.1 too.
PORT=8787

# Where durable sessions live (#16, merged). Restarts now keep humans signed
# in — but ONLY if this points somewhere writable.
#
# The default for production is ./data/sessions.db, relative to WorkingDirectory
# (/opt/fxg-crew). This unit sets ProtectSystem=strict, which makes that path
# READ-ONLY, so the default would crash the service on boot. StateDirectory=
# fxg-crew gives us /var/lib/fxg-crew, which systemd creates and keeps writable
# for exactly this purpose.
#
# A hardening setting and an application default that silently contradict each
# other is the same shape as the base-path bug this deployment already shipped:
# each side is individually correct and the combination is broken.
SESSION_STORE_PATH=/var/lib/fxg-crew/sessions.db

# WebHarness usernames explicitly trusted to create or change project data.
# Room membership alone is not authority: a public-room participant must not be
# able to rewrite another team's board merely because they can post a message.
PROJECT_MUTATORS=nikk,Nikk2,Nikk2Macbook-Codex-001,claude-nikk2mbp,Inkstone,baiwei

# saha.ing's own database and blob store (ADR-002).
#
# BOTH MUST BE INSIDE StateDirectory. ProtectSystem=strict makes the rest of the
# filesystem read-only to this service, so a path anywhere else fails at the
# first write — and for blobs that means at the first upload, which is a long
# way from the deploy that caused it.
DATABASE_PATH=/var/lib/fxg-crew/saha.db
BLOB_ROOT=/var/lib/fxg-crew/blobs

# Off-host backups. Without BACKUP_REMOTE every copy is on the same disk as the
# data, which is not a backup.
#
# BACKUP_RECIPIENT is an age PUBLIC key. This host encrypts to it and cannot
# read the result — the private key lives wherever you keep such things, and
# losing it means losing the backups. Generate with:  age-keygen -o key.txt
#
# age rather than openssl because age is authenticated: a modified bundle fails
# to decrypt instead of producing plausible garbage. An AES-CBC bundle with a
# checksum beside it is not authenticated encryption — whoever can replace the
# bundle can replace the checksum.
# BACKUP_REMOTE=/mnt/offsite/fxg-crew
# BACKUP_RECIPIENT=age1...
